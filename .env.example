# Copy this file to ".env" and fill in your values.

# Supabase / Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session" pooler or direct connection. Example shape:
# postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# The app_user UUID the agent acts as (for audit columns + agentops).
# This is seeded by seed.sql as the Scholarship Officer service user.
AGENT_USER_ID=a4200000-0000-0000-0000-0000000000ff

# ------------------------------------------------------------------
# Gemini chat (OPTIONAL). The chat works fully offline without any of
# this (rule-based). Turn Gemini ON with EITHER of these two ways:
#
# Way 1 — AI Studio API key (simplest). Get a free key at
#   https://aistudio.google.com/apikey  and paste it here:
GEMINI_API_KEY=
#
# Way 2 — Vertex AI on your own Google Cloud (no key, uses gcloud creds
#   and your GCP credit). Requires: `gcloud auth application-default login`
#   and the Vertex AI API enabled on the project. Then set:
# GEMINI_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=project-8dde1e00-67da-41c1-9d9
# GOOGLE_CLOUD_LOCATION=us-central1
# ------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash
