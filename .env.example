# Copy this file to ".env" and fill in your values.

# Supabase / Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session" pooler or direct connection. Example shape:
# postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=

# The app_user UUID the agent acts as (for audit columns + agentops).
# This is seeded by seed.sql as the Scholarship Officer service user.
AGENT_USER_ID=a4200000-0000-0000-0000-0000000000ff

# OPTIONAL. Google Gemini API key for the chat layer (AI Studio key works fine).
# Leave blank to run fully offline — the chat falls back to templated answers.
GEMINI_API_KEY=

# Gemini model to use when a key is present.
GEMINI_MODEL=gemini-2.0-flash
